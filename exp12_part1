#include <stdio.h> 
 
int main() { 
    int n, m, i, j, worst; 
    int block[20], process[20], allocation[20]; 
 
    printf("Enter number of memory blocks: "); 
    scanf("%d", &n); 
 
    printf("Enter size of memory blocks:\n"); 
    for (i = 0; i < n; i++) 
        scanf("%d", &block[i]); 
 
    printf("Enter number of processes: "); 
    scanf("%d", &m); 
 
    printf("Enter size of processes:\n"); 
    for (i = 0; i < m; i++) 
        scanf("%d", &process[i]); 
 
    for (i = 0; i < m; i++) 
        allocation[i] = -1; 
 
    for (i = 0; i < m; i++) { 
        worst = -1; 
 
        for (j = 0; j < n; j++) { 
            if (block[j] >= process[i]) { 
                if (worst == -1 || block[j] > block[worst]) 
                    worst = j; 
            } 
        } 
 
        if (worst != -1) { 
            allocation[i] = worst;                                                                                                                                      block[worst] -= process[i]; 
        } 
    } 
 
    printf("\nProcess\tSize\tBlock\n"); 
 
    for (i = 0; i < m; i++) { 
        if (allocation[i] != -1) 
            printf("P%d\t%d\tB%d\n", 
                   i + 1, process[i], allocation[i] + 1); 
        else 
            printf("P%d\t%d\tNot Allocated\n", 
                   i + 1, process[i]); 
    } 
 
    return 0; 
}
