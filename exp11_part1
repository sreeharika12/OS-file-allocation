#include <stdio.h>
int main() {
    int n, p[8]={1,2,3,1,2,4,1,5}, m[3]={-1,-1,-1}, f[3]={0}, faults=0;
    if (printf("Enter number of apps: ") && scanf("%d",&n)) printf("\nMobile Memory Management - LFU\n");
    for (int i=0, x, j, pos, hit; i<8; i++) {
        for (x=p[i], hit=0, j=0; j<3; j++) if (m[j]==x) { f[j]++; hit=1; printf("Page %d -> Hit, Access Count: %d\n",x,f[j]); break; }
        if (!hit) {
            for (pos=0, j=1; j<3; j++) if (f[j]<f[pos]) pos=j;
            m[pos]=x, f[pos]=1, faults++, printf("Page %d -> Replaced, Access Count: %d\n",x,f[pos]);
        }
    }
    return printf("\nTotal Page Faults = %d\n",faults), 0;
}
