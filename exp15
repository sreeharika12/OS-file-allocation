#include <stdio.h>
#include <string.h>

int main() {
    char photos[20][30], name[30];
    int n = 0, choice, i, found;

    do {
        printf("\n--- DIGITAL CAMERA ---\n");
        printf("1. Capture Photo\n");
        printf("2. View Photos\n");
        printf("3. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                if (n == 20) {
                    printf("Memory full!\n");
                    break;
                }

                printf("Enter photo name: ");
                scanf("%29s", name);

                found = 0;
                for (i = 0; i < n; i++) {
                    if (strcmp(photos[i], name) == 0) {
                        found = 1;
                        break;
                    }
                }

                if (found)
                    printf("Photo already exists!\n");
                else {
                    strcpy(photos[n], name);
                    n++;
                    printf("Photo saved successfully!\n");
                }
                break;

            case 2:
                printf("\nCamera Directory:\n");
                if (n == 0)
                    printf("No photos found.\n");
                else
                    for (i = 0; i < n; i++)
                        printf("%s\n", photos[i]);
                break;

            case 3:
                printf("Exiting camera...\n");
                break;

            default:
                printf("Invalid choice!\n");
        }
    } while (choice != 3);

    return 0;
}  
